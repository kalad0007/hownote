{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hownote",
  "compatibility_date": "2026-08-21",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "binding": "ASSETS",
    "run_worker_first": [
      "/care",
      "/care/*",
      "/ib",
      "/ib/*",
      "/.well-known/oauth-authorization-server",
      "/.well-known/oauth-protected-resource",
      "/.well-known/oauth-protected-resource/care/mcp"
    ]
  },
  "observability": {
    "enabled": true
  },
  "main": "worker/care.mjs",
  "durable_objects": {
    "bindings": [
      {
        "name": "CARE_STORE",
        "class_name": "CareStore"
      },
      {
        "name": "IB_STORE",
        "class_name": "IbStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "care-v1",
      "new_sqlite_classes": [
        "CareStore"
      ]
    },
    {
      "tag": "ib-v1",
      "new_sqlite_classes": ["IbStore"]
    }
  ]
}
