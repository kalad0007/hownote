{
  "name": "hownote",
  "version": "0.6.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "verify:build": "node scripts/verify-build.mjs",
    "verify:safety": "node scripts/verify-purchase-note-safety.mjs",
    "verify:state": "node scripts/verify-tool-state.mjs",
    "verify": "npm run verify:build && npm run verify:safety && npm run verify:state && npm run verify:ib",
    "validate": "npm run build && npm run verify",
    "deploy": "npx wrangler@latest deploy",
    "care:dev": "wrangler dev --local",
    "care:credentials": "node scripts/care-credentials.mjs",
    "test:care": "node tests/care-integration.mjs",
    "ib:local-setup": "node scripts/ib-pin-setup.mjs",
    "ib:seed": "node scripts/ib-local-seed.mjs",
    "ib:dev": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "check:ib": "tsc -p tsconfig.ib.json --noEmit && astro check --tsconfig tsconfig.ib.json",
    "test:ib": "node tests/ib-integration.mjs",
    "test:private": "node scripts/private-test-runner.mjs",
    "test:ib-ui": "playwright test --config playwright.ib.config.mjs",
    "verify:ib": "node scripts/verify-ib-build.mjs",
    "ib:prepare-credentials": "node scripts/ib-pin-setup.mjs",
    "ib:pin": "node scripts/ib-pin-setup.mjs",
    "test:ib-pin": "node tests/ib-reader-auth.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.4",
    "markdown-it": "^15.0.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.63.0",
    "@types/markdown-it": "^14.2.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.131.1"
  }
}
