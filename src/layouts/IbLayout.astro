---
import '../styles/ib.css';
import { categoryLabels } from '../data/ib';
interface Props {title:string;page:'index'|'research'|'edit'|'subjects'}
const {title,page}=Astro.props;
const build=__HOWNOTE_BUILD_SHA__;
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" /><meta name="hownote-build" content={build} />
  <meta name="theme-color" content="#f6f5f0" /><meta name="color-scheme" content="light" />
  <title>{title} · HowNote</title>
  <link rel="canonical" href={new URL(Astro.url.pathname,'https://hownote.net')} />
  <link rel="manifest" href="/site.webmanifest" /><link rel="icon" href="/favicon.svg" />
</head>
<body data-page={page}>
  <a class="skip-link" href="#content">본문으로 이동</a>
  <header class="ib-header">
    <a class="ib-brand" href="/ib">HowNote <span>IB 연구실</span></a>
    <div id="identity" hidden><span id="reader-name"></span><button id="logout" type="button" class="quiet">로그아웃</button></div>
    <span id="private-label" class="muted">개인 읽기 공간</span>
  </header>
  <main id="login-view" class="login-view" hidden>
    <h1>나의 IB 연구실</h1>
    <p>도비가 정리한 연구와 문항 설계 기록을 읽는 곳입니다.<br />숫자 네 자리로 열어보세요.</p>
    <form id="login-form">
      <label for="pin">4자리 PIN</label>
      <input id="pin" class="pin-input" name="pin" type="password" inputmode="numeric" autocomplete="current-password" minlength="4" maxlength="4" pattern="[0-9]{4}" enterkeyhint="go" aria-describedby="pin-hint" required />
      <p id="pin-hint" class="hint">숫자 4자리를 입력하세요.</p>
      <button class="primary" type="submit">연구실 열기</button>
      <p id="login-error" class="error" role="alert"></p>
    </form>
    <p class="muted small">허용된 연구 자료의 출처·이용범위·검수 이력을 함께 기록합니다.</p>
  </main>
  <div id="loading" class="loading-state" role="status">연구실을 열고 있습니다…</div>
  <div id="workspace" class="workspace" hidden>
    <aside class="sidebar">
      <nav aria-label="IB 연구 분류">
        <a href="/ib" data-category="all">연구 모아보기</a>
        {Object.entries(categoryLabels).map(([key,label])=><a href={`/ib?category=${key}`} data-category={key}>{label}</a>)}
      </nav>
      <div class="sidebar-bottom">
        <a href="/ib/subjects" id="subjects-nav">과목 안내</a>
        <p>과목은 조사 후보부터 관리합니다.<br />표시 순서는 인기 순위가 아닙니다.</p>
        <a href="/" class="home-link">HowNote 홈</a>
      </div>
    </aside>
    <main id="content" tabindex="-1">
      <div id="notice" role="status" aria-live="polite"></div>
      <slot />
    </main>
  </div>
  <noscript><p class="loading-state">연구실을 이용하려면 브라우저에서 JavaScript를 켜 주세요.</p></noscript>
  <script>import '../scripts/ib';</script>
</body>
</html>
